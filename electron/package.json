{
  "name": "dhara-desktop",
  "productName": "Dhara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": { "node": "^22.22.2" },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "unit": "vitest run",
    "e2e": "playwright test",
    "test": "npm run build && npm run unit && npm run e2e",
    "package": "bash ../release/build.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.18.10",
    "electron": "44.7.0",
    "node": "22.23.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

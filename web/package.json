    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "node": "22.23.3",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  }

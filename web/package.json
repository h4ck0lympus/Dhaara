{
  "name": "noema-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.22.2" },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/sw-precache.mjs && node scripts/check-hashes.mjs",
